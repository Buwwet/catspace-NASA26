#CODE GENERATED BY GEMINI 4 HYDROGEN THINKING
extends CanvasLayer

@onready var start_menu: Control = $StartMenu
@onready var generic_popup: Control = $GenericPopup
@onready var generic_tooltip: PanelContainer = $GenericTooltip

var _popup_queue: Array[Dictionary] = []
var _last_focused: Control = null

func _ready() -> void:
	generic_popup.hide()
	generic_tooltip.hide()
	
	# Internal connections
	generic_popup.closed.connect(_on_popup_closed)
	start_menu.play_requested.connect(_on_start_game)
	start_menu.quit_requested.connect(_on_quit_requested)
	
	start_menu.show()
	start_menu.focus_default()

func _process(_delta: float) -> void:
	if generic_tooltip.visible:
		_update_tooltip_position()

func _unhandled_input(event: InputEvent) -> void:
	if event.is_action_pressed("ui_cancel") and generic_popup.visible:
		_on_popup_closed()
		get_viewport().set_input_as_handled()

# --- Public API for the rest of the team ---

func show_popup(title: String, body: String, on_confirm: Callable = Callable(), show_cancel: bool = true) -> void:
	var data := {
		"title": title,
		"body": body,
		"on_confirm": on_confirm,
		"show_cancel": show_cancel
	}
	if generic_popup.visible:
		_popup_queue.append(data)
		return
	_open_popup(data)

func show_tooltip(text: String) -> void:
	if generic_popup.visible:
		return
	generic_tooltip.set_text(text)
	generic_tooltip.show()
	_update_tooltip_position()

func hide_tooltip() -> void:
	generic_tooltip.hide()

# --- Internal Logic ---

func _open_popup(data: Dictionary) -> void:
	_last_focused = get_viewport().gui_get_focus_owner()
	hide_tooltip()
	generic_popup.setup(data.title, data.body, data.on_confirm, data.show_cancel)
	generic_popup.show()
	generic_popup.focus_default()

func _on_popup_closed() -> void:
	generic_popup.hide()
	if not _popup_queue.is_empty():
		_open_popup(_popup_queue.pop_front())
	elif is_instance_valid(_last_focused):
		_last_focused.grab_focus()

func _update_tooltip_position() -> void:
	var target_pos := get_viewport().get_mouse_position() + Vector2(16, 16)
	var viewport_size := get_viewport().get_visible_rect().size
	target_pos.x = clampf(target_pos.x, 0.0, viewport_size.x - generic_tooltip.size.x)
	target_pos.y = clampf(target_pos.y, 0.0, viewport_size.y - generic_tooltip.size.y)
	generic_tooltip.global_position = target_pos

func _on_start_game() -> void:
	start_menu.hide()
	# Here you call your SceneManager or change scenes:
	# get_tree().change_scene_to_file("res://levels/level_01.tscn")

func _on_quit_requested() -> void:
	show_popup("Salir del juego", "¿Seguro que quieres salir?", func(): get_tree().quit())
