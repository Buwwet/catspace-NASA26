class_name GenericButton
extends Button

@export var hover_tooltip: String = ""

@export var background_texture: Texture2D:
	set(value):
		background_texture = value
		if is_node_ready():
			_apply_sprite()
			

## Tamaño final del botón. Déjalo en (0, 0) para usar el tamaño que ya se ve
## en el editor (textura × escala del Sprite2D).
@export var button_size: Vector2 = Vector2.ZERO:
	set(value):
		button_size = value
		if is_node_ready():
			_apply_sprite()

@onready var sprite: Sprite2D = $Sprite2D

var _on_click: Callable

var _base_scale := Vector2.ONE


func _ready() -> void:
	pressed.connect(_handle_pressed)
	mouse_entered.connect(_handle_mouse_entered)
	mouse_exited.connect(_handle_mouse_exited)
	_base_scale = sprite.scale 
	_setup_sprite_layer()
	_apply_sprite()
	resized.connect(_fit_sprite)

func _setup_sprite_layer() -> void:
	sprite.centered = false
	sprite.position = Vector2.ZERO
	# Dibuja el sprite DETRÁS del botón, así el texto queda visible
	sprite.show_behind_parent = true
	# Quita el estilo por defecto del botón para que no tape el sprite
	for state in ["normal", "hover", "pressed", "hover_pressed", "disabled"]:
		add_theme_stylebox_override(state, StyleBoxEmpty.new())

func _apply_sprite() -> void:
	if background_texture:
		sprite.texture = background_texture
	if sprite.texture == null:
		return
	# El botón toma el tamaño del sprite
	var target: Vector2 = button_size if button_size != Vector2.ZERO \
		else sprite.texture.get_size() * _base_scale
	custom_minimum_size = target
	size = target
	_fit_sprite()

func _fit_sprite() -> void:
	if sprite == null or sprite.texture == null:
		return
	# Si un contenedor estira el botón, el sprite se escala para seguirlo
	sprite.scale = size / sprite.texture.get_size()

# Método principal para configurar texto, acción y tooltip en una sola línea
func setup(button_text: String, callback: Callable, tooltip: String = "") -> void:
	text = button_text
	_on_click = callback
	if not tooltip.is_empty():
		hover_tooltip = tooltip

# Permite cambiar solo la función más adelante sin alterar el texto
func set_callback(callback: Callable) -> void:
	_on_click = callback

func _handle_pressed() -> void:
	# is_valid() evita errores si el nodo dueño de la función fue eliminado (queue_free)
	if _on_click.is_valid():
		_on_click.call()

func _handle_mouse_entered() -> void:
	if not hover_tooltip.is_empty():
		UIManager.show_tooltip(hover_tooltip)

func _handle_mouse_exited() -> void:
	if not hover_tooltip.is_empty():
		UIManager.hide_tooltip()
